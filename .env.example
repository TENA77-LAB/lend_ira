# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# ID чата, куда приходят заявки (у Ирины: 6977489359)
# Важно: сначала напишите боту /start в Telegram
TELEGRAM_CHAT_ID=6977489359

# Необязательно: домен сайта для CORS (например https://your-site.ru)
# ALLOWED_ORIGIN=https://your-site.ru

# Админка: пароль для входа на /admin.html
ADMIN_PASSWORD=придумайте-надёжный-пароль

# Хранилище заявок (бесплатный Redis на https://upstash.com)
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=example_token
